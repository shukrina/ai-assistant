# Copy this file to .env and fill in your values.

# --- Provider selection ---
LLM_PROVIDER=openai              # openai | anthropic | gemini | local
FALLBACK_LLM_PROVIDER=local      # used automatically if the primary fails
# NOTE: "local" assumes the vLLM container/service is actually running
# (see docker-compose "local-llm" profile). If you're not running vLLM,
# set this to a second real provider (e.g. the same as LLM_PROVIDER, or
# a different one) so fallback has something reachable to call.

# --- API keys (only fill in the ones you use) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Local model (served via vLLM, OpenAI-compatible) ---
LOCAL_LLM_BASE_URL=http://vllm:8001/v1
LOCAL_LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# --- Generation params ---
TEMPERATURE=0.3
TOP_P=0.9
MAX_TOKENS=1024

# --- RAG ---
VECTOR_DB_PATH=./data/chroma
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4

# --- Database ---
DATABASE_URL=sqlite:///./data/app.db

# --- Reliability ---
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=1.0
RATE_LIMIT_PER_MINUTE=30
REQUEST_TIMEOUT_SECONDS=30

# --- Cache ---
CACHE_TTL_SECONDS=600
CACHE_MAX_SIZE=512

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
